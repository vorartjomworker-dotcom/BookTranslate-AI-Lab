APP_NAME=BookTranslate AI Lab
DATABASE_URL=postgresql+asyncpg://booktranslate:booktranslate@postgres:5432/booktranslate
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
MAX_ARCHIVE_UNCOMPRESSED_MB=100
MAX_ARCHIVE_ENTRIES=500
SEGMENT_TARGET_CHARS=2000
SEGMENT_HARD_LIMIT_CHARS=3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
DEEPL_API_KEY=
DEEPL_USE_PRO=false

DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o
TRANSLATION_TIMEOUT=30
TRANSLATION_BATCH_SIZE=5
MAX_RETRIES=3
TRANSLATION_STREAM_NAME=translation_jobs
TRANSLATION_CONSUMER_GROUP=translation-workers
TRANSLATION_DLQ_STREAM_NAME=translation_jobs_dlq
TRANSLATION_CONSUMER_NAME=translator-worker-1
TRANSLATION_STREAM_BLOCK_MS=5000
TRANSLATION_JOB_RETRY_LIMIT=3
TRANSLATION_JOB_TIMEOUT_SECONDS=300
TRANSLATION_JOB_MAX_STALE_MS=60000
QA_ENABLED=true
AUTO_APPROVE_THRESHOLD=95
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=ru
