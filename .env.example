# Required. Generate a local value before docker compose up; do not commit real secrets.
JWT_SECRET=
# Production orchestrators may mount sensitive application values as files instead of plaintext environment values.
# Supported file variables: JWT_SECRET_FILE, DATABASE_URL_FILE, REDIS_URL_FILE, METRICS_BEARER_TOKEN_FILE,
# OPENAI_API_KEY_FILE, ANTHROPIC_API_KEY_FILE, and DEEPL_API_KEY_FILE.
# Example: JWT_SECRET_FILE=/run/secrets/booktranslate_jwt
# Do not set both JWT_SECRET and JWT_SECRET_FILE (or both forms of any supported secret); startup fails closed on ambiguity.
# The base local docker-compose.yml intentionally continues to require direct JWT_SECRET/POSTGRES_PASSWORD/REDIS_PASSWORD.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
# Durable PostgreSQL-backed lockout after consecutive invalid passwords.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
# Exact CORS origins only. Remote origins must use HTTPS; plain HTTP is allowed only for loopback development.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
APP_NAME=BookTranslate AI Lab
LOG_LEVEL=INFO
# Metrics are off by default. When enabled, METRICS_BEARER_TOKEN must be a separate secret with at least 32 characters.
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
# Frontend API origin is compiled into the production bundle. Remote deployments must use an exact https:// origin.
# Local development may use http://localhost / 127.0.0.1 / [::1]. Userinfo, paths, query strings, and fragments are rejected.
# An unsafe value fails frontend configuration/build closed without echoing the configured URL into the validation error.
NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_DB=booktranslate
POSTGRES_USER=booktranslate
# Required. Generate a separate unique local database password; do not commit real secrets.
POSTGRES_PASSWORD=
# Compose builds its default DATABASE_URL from POSTGRES_PASSWORD. Override DATABASE_URL only for an external database.
# DATABASE_URL=postgresql+asyncpg://booktranslate:<password>@postgres:5432/booktranslate
# Production file-backed alternative: DATABASE_URL_FILE=/run/secrets/booktranslate_database_url

# Required by the local Compose Redis service. Generate a separate URL-safe value.
REDIS_PASSWORD=
# Local Compose uses authenticated redis:// on the private Docker network and localhost-only host binding.
REDIS_TLS_REQUIRED=false
# For an external/managed production Redis service, require TLS and provide a rediss:// URL, for example:
# REDIS_TLS_REQUIRED=true
# REDIS_URL=rediss://:<password>@<redis-host>:6380/0
# Production file-backed alternative: REDIS_URL_FILE=/run/secrets/booktranslate_redis_url
# When REDIS_TLS_REQUIRED=true, the application refuses to start with a plaintext redis:// URL, including one loaded from REDIS_URL_FILE.

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
MAX_ARCHIVE_UNCOMPRESSED_MB=100
MAX_ARCHIVE_ENTRIES=500
SEGMENT_TARGET_CHARS=2000
SEGMENT_HARD_LIMIT_CHARS=3000

OPENAI_API_KEY=
# Production file-backed alternative: OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Production file-backed alternative: ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
DEEPL_API_KEY=
# Production file-backed alternative: DEEPL_API_KEY_FILE=/run/secrets/deepl_api_key
DEEPL_USE_PRO=false

DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o
TRANSLATION_TIMEOUT=30
TRANSLATION_BATCH_SIZE=5
MAX_RETRIES=3
TRANSLATION_STREAM_NAME=translation_jobs
TRANSLATION_CONSUMER_GROUP=translation-workers
TRANSLATION_DLQ_STREAM_NAME=translation_jobs_dlq
TRANSLATION_CONSUMER_NAME=translator-worker-1
TRANSLATION_STREAM_BLOCK_MS=5000
TRANSLATION_JOB_RETRY_LIMIT=3
TRANSLATION_JOB_TIMEOUT_SECONDS=300
TRANSLATION_JOB_MAX_STALE_MS=60000
QA_ENABLED=true
AUTO_APPROVE_THRESHOLD=95
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=ru
BENCHMARK_ALLOW_LIVE_PROVIDER=false
BENCHMARK_DEFAULT_MAX_CASES=10
BENCHMARK_DEFAULT_TIMEOUT_SECONDS=30
BENCHMARK_DEFAULT_CONCURRENCY=1
BENCHMARK_DEFAULT_MAX_RETRIES=2
BENCHMARK_DEFAULT_MAX_BUDGET_USD=5.0
BENCHMARK_DATASET_NAME=technical_translation
BENCHMARK_DATASET_VERSION=2026.08.15

# CLI bootstrap only; never expose these through an HTTP endpoint.
ADMIN_EMAIL=
ADMIN_PASSWORD=
